{
  "seed": 42,
  "batch_size": 32,
  "learning_rate": 0.001,
  "adam_epsilon": 1e-07,
  "method": "fastset",
  "architecture": {
    "family": "transformer",
    "mode": "split",
    "specs": {
      "e2e": {
        "family": "transformer",
        "role": "e2e",
        "depth": 8,
        "width": 100,
        "heads": 4,
        "token_hidden": 32
      },
      "est": {
        "family": "transformer",
        "role": "est",
        "depth": 3,
        "width": 28,
        "heads": 4,
        "token_hidden": 16
      },
      "dem": {
        "family": "transformer",
        "role": "dem",
        "depth": 12,
        "width": 80,
        "heads": 4,
        "token_hidden": 32
      }
    }
  },
  "pretrain": {
    "mode": "sequential",
    "est_epochs": 5,
    "dem_epochs": 10,
    "joint_epochs": 0,
    "cnn_epochs": 0
  },
  "online": {
    "est_iterations": 5,
    "dem_iterations": 200,
    "joint_iterations": 0,
    "cnn_iterations": 0,
    "early_stop": true
  },
  "batch_order": "cycle_restart_each_stage",
  "target_ber": 0.0002
}
